{
  "name": "groundwork",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "scripts": {
    "start": "expo start --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node --max-old-space-size=4096 --max-http-header-size=131072 node_modules/expo/bin/cli start --web",
    "export:web": "expo export -p web",
    "export:web:pwa": "expo export -p web && node pwa/generate-precache-sw.mjs",
    "build": "npm run export:web:pwa",
    "vercel-build": "npm run export:web:pwa",
    "migrate:neon": "node scripts/apply_neon_schema.js",
    "migrate:neon:test-rollback": "node scripts/apply_neon_schema.js --test-rollback",
    "migrate:data": "node scripts/migrate_supabase_to_neon.js",
    "postinstall": "node -e \"try{if(require('fs').existsSync('scripts/patch-expo-av.js'))require('child_process').execSync('node scripts/patch-expo-av.js',{stdio:'inherit'})}catch(e){}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@neondatabase/auth": "^0.5.0-beta",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/postgrest-js": "^1.21.4",
    "date-fns": "^4.1.0",
    "expo": "57",
    "expo-auth-session": "~57.0.15",
    "expo-av": "~16.0.8",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-notify-kit": "^10.4.3",
    "react-native-pell-rich-editor": "^1.10.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
